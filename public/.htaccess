# Hostinger / Apache defense layer — blocks common PHP malware & SEO spam probes.
# Your live app runs on Node, but this protects the public folder if Apache serves it.

Options -Indexes

<FilesMatch "\.(php|phtml|php5|phar|cgi|pl|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^wp-admin - [F,L]
  RewriteRule ^wp-login\.php - [F,L]
  RewriteRule ^wp-content/ - [F,L]
  RewriteRule ^wp-includes/ - [F,L]
  RewriteRule ^xmlrpc\.php - [F,L]
  RewriteRule ^\.env - [F,L]
  RewriteRule ^\.git - [F,L]
</IfModule>
