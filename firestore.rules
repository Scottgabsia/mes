rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'contact@vr-astrovision.com' ||
        request.auth.token.email == 'admin@forensic.com' ||
        request.auth.token.email == 'info@cryptorecoveryasset.com' ||
        request.auth.token.email.matches('.*@cryptorecoveryasset\\.com$') ||
        request.auth.token.email.matches('.*@forensic\\.com$')
      );
    }

    match /recovery_requests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list, read, update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read, write: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
