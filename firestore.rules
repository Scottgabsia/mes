rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'contact@vr-astrovision.com';
    }

    match /recovery_requests/{document=**} {
      // Direct access allowed as requested for admin view
      allow read, write: if true;
    }
    
    // Explicit deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
