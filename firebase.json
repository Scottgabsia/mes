{
  "functions": {
    "source": "functions",
    "codebase": "default"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "mes"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": [
    {
      "database": "ai-studio-c96044ac-749e-461f-9e72-3f749d0a603e",
      "rules": "firestore.rules"
    }
  ]
}
