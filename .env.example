# Local: copy to .env — Hostinger: hPanel → Environment variables

NODE_ENV=production
ADMIN_EMAIL=info@cryptorecoveryasset.com

# Admin API: verify Firebase ID tokens (defaults to firebase-applet-config.json apiKey)
# FIREBASE_API_KEY=

# REQUIRED on Hostinger: path OUTSIDE the git deploy folder (cases survive redeploys)
# CASE_DATA_DIR=/home/.../domains/cryptorecoveryasset.com/data
# If unset, app.cjs uses ../case-data and merges legacy data/recovery-cases.json on startup

# Optional: armored OpenPGP public key for Forensic Toolkit → PGP Payload Encoder
# FORENSIC_PGP_PUBLIC_KEY=

# Option A — Titan SMTP (preferred; mail arrives in your Titan inbox)
SMTP_HOST=smtp.titan.email
# Optional if Hostinger cannot resolve hostname (not needed for 535 auth errors):
# SMTP_HOST_IP=3.234.93.86
SMTP_PORT=465
SMTP_USER=info@cryptorecoveryasset.com
SMTP_PASS=your_titan_app_password

# Option B — Resend (used only if SMTP_* is not set)
# RESEND_API_KEY=re_xxxxxxxx
# IMPORTANT: use your verified domain sender (not onboarding@resend.dev)
# RESEND_FROM=Crypto Recovery <info@cryptorecoveryasset.com>

# EmailJS browser fallback (only if Node API is unreachable — not primary on Hostinger)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Do NOT set VITE_API_BASE_URL on Hostinger Node deploy — same-origin /api is used automatically.
