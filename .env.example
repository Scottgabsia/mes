# Local: copy to .env — Hostinger: hPanel → Environment variables

NODE_ENV=production

# Resend (https://resend.com) — required for form emails when Node API runs
RESEND_API_KEY=re_xxxxxxxx
# After verifying cryptorecoveryasset.com in Resend:
RESEND_FROM=Crypto Recovery <info@cryptorecoveryasset.com>
# For testing only (sends to your Resend account email):
# RESEND_FROM=Crypto Recovery <onboarding@resend.dev>
ADMIN_EMAIL=info@cryptorecoveryasset.com

# EmailJS (browser-only fallback on static hosting — optional)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ADMIN_EMAIL=info@cryptorecoveryasset.com

# Optional — static site + Firebase Functions API:
# VITE_API_BASE_URL=https://us-central1-mysterybritishsh-1748710084193.cloudfunctions.net/mes

# PORT is set by Hostinger automatically
