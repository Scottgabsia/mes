# Local development: copy to .env and fill in SMTP_PASS
# Hostinger production: add these in hPanel → Environment variables (do not commit .env)

NODE_ENV=production
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@cryptorecoveryasset.com
SMTP_PASS=your_titan_password_or_app_password
ADMIN_EMAIL=info@cryptorecoveryasset.com

# Optional — only if using Gemini features at build time
# GEMINI_API_KEY=

# Only if the frontend is static but API runs elsewhere (Firebase Functions):
# VITE_API_BASE_URL=https://us-central1-mysterybritishsh-1748710084193.cloudfunctions.net/mes

# Set by Hostinger automatically — do not set locally unless testing
# PORT=3000
